{
  "enabled": true,
  "provider": "gemini",
  "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
  "model": "gemini-3.5-flash-lite",
  "fallbackModels": [],
  "maximumRequestsPerMinute": 15,
  "apiKeyEnvironmentVariable": "GEMINI_API_KEY",
  "timeoutSeconds": 30,
  "initialRequestTimeoutSeconds": 15,
  "retryRequestTimeoutSeconds": 10,
  "diagnosticEvents": true,
  "contextLength": 3072,
  "maximumOutputTokens": 512,
  "thinking": false,
  "thinkingBudget": 0,
  "thinkingLevel": "minimal",
  "keepAlive": "30m",
  "minimumConfidence": 0.85,
  "requiredAgreementCount": 1,
  "coordinateTolerance": 0.035,
  "campusCoordinateTolerance": 0.06,
  "analysisIntervalMs": 2500,
  "aiOnlyFallbackAfterSeconds": 60,
  "aiProbeIntervalSeconds": 12.0,
  "retryAfterErrorSeconds": 16,
  "saveUnknownScreenshots": true,
  "maximumDebugCaptures": 200,
  "debugDirectory": "debug"
}
